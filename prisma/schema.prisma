// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id       String @id @default(cuid())
  email    String @unique
  password String // Hashed password
  name     String?
}

model TeamMember {
  id              String  @id @default(cuid())
  name            String
  role            String
  quote           String
  img             String
  color           String
  text            String
  gradient        String
  socialEmail     String?
  socialPortfolio String?
  socialLinkedin  String?
}

model Service {
  id          String @id // The URL slug
  title       String
  subtitle    String
  description String
  heroImage   String
  features    String // JSON string: {title, description, icon?, link?}[]
  ctaText     String
  ctaLink     String
}

model PortfolioItem {
  id              String  @id // slug
  title           String
  category        String
  client          String?
  description     String
  fullDescription String
  coverImage      String
  galleryImages   String // JSON string: string[]
  videoUrl        String?
  tags            String // JSON string: string[]
  date            String?
}

model BlogPost {
  slug       String @id
  title      String
  excerpt    String
  content    String
  date       String
  author     String
  authorRole String
  coverImage String
  tags       String // JSON string: string[]
}
