generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String?
}

model TeamMember {
  id              String  @id @default(cuid())
  name            String
  role            String
  quote           String
  img             String
  color           String
  text            String
  gradient        String
  socialEmail     String?
  socialPortfolio String?
  socialLinkedin  String?
}

model Service {
  id          String @id
  title       String
  subtitle    String
  description String
  heroImage   String
  features    String
  ctaText     String
  ctaLink     String
}

model PortfolioItem {
  id              String  @id
  title           String
  category        String
  client          String?
  description     String
  fullDescription String
  coverImage      String
  galleryImages   String
  videoUrl        String?
  tags            String
  date            String?
}

model BlogPost {
  slug       String @id
  title      String
  excerpt    String
  content    String
  date       String
  author     String
  authorRole String
  coverImage String
  tags       String
}
